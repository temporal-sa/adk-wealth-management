export TEMPORAL_ADDRESS=<namespace>.<accountID>.tmprl.cloud:7233
export TEMPORAL_NAMESPACE=<namespace>.<accountID>
# Authenticate with either mTLS certificates...
export TEMPORAL_TLS_CLIENT_CERT_PATH="/path/to/cert.pem"
export TEMPORAL_TLS_CLIENT_KEY_PATH="/path/to/key.key"
# ...or an API key (use the <region>.<cloud>.api.temporal.io:7233 address instead)
# export TEMPORAL_API_KEY="<api key>"